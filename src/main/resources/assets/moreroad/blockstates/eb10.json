{
  "multipart": [
    {
      "when": { "facing": "north" },
      "apply": { "model": "moreroad:block/poteau_block" }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "moreroad:block/poteau_block", "y": 90 }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "moreroad:block/poteau_block", "y": 180 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "moreroad:block/poteau_block", "y": 270 }
    },

    {
      "when": { "facing": "north", "eb20": "false" },
      "apply": { "model": "moreroad:block/eb10" }
    },
    {
      "when": { "facing": "east", "eb20": "false" },
      "apply": { "model": "moreroad:block/eb10", "y": 90 }
    },
    {
      "when": { "facing": "south", "eb20": "false" },
      "apply": { "model": "moreroad:block/eb10", "y": 180 }
    },
    {
      "when": { "facing": "west", "eb20": "false" },
      "apply": { "model": "moreroad:block/eb10", "y": 270 }
    },

    {
      "when": { "facing": "north", "eb20": "true" },
      "apply": { "model": "moreroad:block/eb20" }
    },
    {
      "when": { "facing": "east", "eb20": "true" },
      "apply": { "model": "moreroad:block/eb20", "y": 90 }
    },
    {
      "when": { "facing": "south", "eb20": "true" },
      "apply": { "model": "moreroad:block/eb20", "y": 180 }
    },
    {
      "when": { "facing": "west", "eb20": "true" },
      "apply": { "model": "moreroad:block/eb20", "y": 270 }
    }
  ]
}
